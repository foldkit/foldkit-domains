{
  "name": "foldkit-domains",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev --local",
    "typecheck": "tsc --noEmit && pnpm --dir infra exec tsc --noEmit",
    "format": "oxfmt --disable-nested-config",
    "test": "vitest run",
    "lint": "oxlint src && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src",
    "format:check": "oxfmt --check --disable-nested-config",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "plan": "pnpm --dir infra exec alchemy plan",
    "deploy": "pnpm --dir infra exec alchemy deploy",
    "dev:cloudflare": "pnpm --dir infra exec alchemy dev",
    "test:e2e:worker": "playwright test --config playwright.worker.config.ts",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "generate:social": "node scripts/generate-social-assets.ts"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.6",
    "@foldkit/devtools": "0.169.0-canary.90746b32d2ca",
    "@foldkit/ui": "0.169.0-canary.90746b32d2ca",
    "@fontsource-variable/geist": "^5.3.0",
    "effect": "4.0.6",
    "foldkit": "0.169.0-canary.90746b32d2ca"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@effect/tsgo": "0.50.0",
    "@foldkit/devtools-mcp": "0.25.0-canary.90746b32d2ca",
    "@foldkit/oxlint-plugin": "0.15.3-canary.90746b32d2ca",
    "@foldkit/vite-plugin": "0.28.0-canary.90746b32d2ca",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.3",
    "vitest": "^5.0.2",
    "wrangler": "4.152.0"
  },
  "private": true,
  "description": "A domain-search showcase built with Cloudflare, Alchemy, Foldkit, and Effect",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.11.1"
  }
}
