{
  "name": "foldkit-domains",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --disable-nested-config",
    "test": "vitest run",
    "lint": "oxlint src && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src",
    "format:check": "oxfmt --check --disable-nested-config",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "effect": "4.0.0",
    "foldkit": "file:vendor/foldkit-preview/foldkit-0.169.0-canary.732258ae40bf.tgz"
  },
  "devDependencies": {
    "@effect/tsgo": "0.50.0",
    "@foldkit/devtools": "file:vendor/foldkit-preview/foldkit-devtools-0.169.0-canary.732258ae40bf.tgz",
    "@foldkit/devtools-mcp": "file:vendor/foldkit-preview/foldkit-devtools-mcp-0.25.0-canary.732258ae40bf.tgz",
    "@foldkit/oxlint-plugin": "file:vendor/foldkit-preview/foldkit-oxlint-plugin-0.15.3-canary.732258ae40bf.tgz",
    "@foldkit/vite-plugin": "file:vendor/foldkit-preview/foldkit-vite-plugin-0.28.0-canary.732258ae40bf.tgz",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.3",
    "vitest": "^5.0.2",
    "@foldkit/ui": "file:vendor/foldkit-preview/foldkit-ui-0.169.0-canary.732258ae40bf.tgz"
  },
  "private": true,
  "description": "A statically rendered domain search example built with Foldkit",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.22.2"
  }
