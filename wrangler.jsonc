{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foldkit-domains",
  "main": "./dist/server/fetch.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "new_module_registry",
    "nodejs_compat",
    "enable_request_signal",
    "request_signal_passthrough",
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DOMAIN_QUOTES", "class_name": "DomainSearchCoordinator" },
      { "name": "REGISTRAR_BUDGET", "class_name": "RegistrarCoordinator" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DomainSearchCoordinator", "RegistrarCoordinator"],
    },
  ],
  "assets": {
    "directory": "./dist/client",
  },
}
